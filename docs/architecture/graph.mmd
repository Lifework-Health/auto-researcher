flowchart TD
    START((START)) --> initialise[initialise_run]
    initialise -->|valid identifiers| prepare[supervisor_prepare]
    initialise -->|invalid identifiers| END
    prepare -->|budget available| knowledge["retrieve_knowledge<br/>deterministic adapter"]
    prepare -->|stop/error| provenance[record_provenance]
    knowledge -->|disabled, optional, or validated| hypothesis[generate_hypothesis]
    knowledge -->|required unavailable| provenance
    hypothesis["generate_hypothesis<br/>mock or bounded live + reconcile"] --> planner["plan_search<br/>mock or bounded live + reconcile"]
    planner --> approvalRouter[approval_router]
    approvalRouter -->|required| human[human_approval interrupt]
    approvalRouter -->|not required| searchRouter[search_router]
    human -->|approved| searchRouter
    human -->|rejected| provenance
    searchRouter -->|DIRECT installed + allowed| direct[direct_search]
    searchRouter -->|OPTUNA installed + task capable + allowed| optunaPrepare[optuna_prepare_study]
    searchRouter -->|unavailable or disallowed| unavailable[unavailable_backend]
    direct --> evaluator[evaluate_experiment]
    optunaPrepare --> optunaAsk[optuna_ask_trial]
    optunaPrepare -->|recover running trial| optunaCreate[optuna_create_experiment]
    optunaAsk --> optunaCreate
    optunaCreate --> evaluator
    evaluator --> verifier[verify_evidence]
    verifier -->|DIRECT| provenance
    verifier -->|OPTUNA| optunaTell[optuna_tell_trial]
    optunaTell --> optunaRecord[optuna_record_trial]
    optunaRecord --> optunaDecide[optuna_decide_study]
    optunaDecide -->|budget remains| optunaAsk
    optunaDecide -->|finished| optunaFinal[optuna_finalise_study]
    optunaFinal --> decide
    unavailable --> provenance
    provenance --> decide[supervisor_decide]
    decide -->|continue + reserve next cycle| knowledge
    decide -->|complete, stopped, failed| END((END))

    checkpointer[(LangGraph checkpointer)]
    provenanceStore[(append-only provenance SQLite)]
    optunaStore[(separate Optuna SQLite)]
    agentCallStore[(separate agent-call SQLite)]
    knowledgeStore[(separate knowledge-retrieval SQLite)]
    neo4j[("external Neo4j<br/>read-only")]
    human -. pause/resume .-> checkpointer
    provenance -. append .-> provenanceStore
    optunaPrepare -. study identity .-> optunaStore
    optunaAsk -. ask .-> optunaStore
    optunaTell -. tell .-> optunaStore
    hypothesis -. reserve / outcome .-> agentCallStore
    planner -. reserve / outcome .-> agentCallStore
    knowledge -. reserve / bundle .-> knowledgeStore
    knowledge -. fixed parameterised reads .-> neo4j

    classDef llm fill:#d9e8ff,stroke:#245aa5,color:#10233f
    classDef deterministic fill:#e5f5e0,stroke:#3b7d23,color:#17310e
    classDef backend fill:#fff1cc,stroke:#a66b00,color:#4d3100
    classDef persistence fill:#f1e4ff,stroke:#7040a0,color:#2e1745
    classDef scientific fill:#ffe5e5,stroke:#a23b3b,color:#451515

    class hypothesis,planner llm
    class initialise,prepare,knowledge,approvalRouter,human,searchRouter,provenance,decide,unavailable deterministic
    class evaluator,verifier scientific
    class direct,optunaPrepare,optunaAsk,optunaTell backend
    class checkpointer,provenanceStore,optunaStore,agentCallStore,knowledgeStore persistence
